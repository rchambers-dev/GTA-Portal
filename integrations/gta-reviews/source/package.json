{
  "name": "review-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:desktop": "concurrently -k -n web,desktop -c cyan,magenta \"node server/dev.js\" \"wait-on http://127.0.0.1:4173 && electron . --dev\"",
    "build": "node server/build.js",
    "start": "node server/index.js",
    "start:desktop": "npm run build && electron .",
    "test": "vitest run",
    "lint": "eslint .",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "~2.117.2",
    "docx-preview": "^0.4.1",
    "esbuild": "^0.25.12",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "electron": "^45.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vite": "$vite",
    "minimatch": "^11.0.1"
  }
}
