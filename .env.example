# Copy to `.env.local` and fill in when ready. Never commit real keys.

# Portal mode
# Leave DEMO_MODE unset/false for real logins. Only set true for local fiction testing.
NEXT_PUBLIC_DEMO_MODE=false

# Data adapter: `supabase` for live auth + data (default for real use)
DATA_ADAPTER=supabase

# Optional absolute base URL for auth redirects and server-side flows
# NEXT_PUBLIC_PORTAL_BASE_URL=http://localhost:3000

# Supabase (Project Settings ? API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional hCaptcha (Supabase Auth ? Attack Protection)
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# Provider: stub | openai | anthropic
AI_PROVIDER=stub

# Shared API key for the portal AI layer (preferred)
AI_API_KEY=

# Optional aliases if you already use provider-specific names
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Model id for the chosen provider
# AI_MODEL=gpt-4o-mini
# AI_MODEL=claude-sonnet-4-20250514

# Optional OpenAI-compatible base URL (proxies / Azure / gateways)
# AI_BASE_URL=https://api.openai.com/v1

# Soft per-account daily cap across ALL AI features (0 = unlimited)
AI_DAILY_REQUEST_CAP=50

# Optional: used only by `npm run bootstrap:superadmin`
# BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@gta-portal.local
# BOOTSTRAP_SUPERADMIN_PASSWORD=

# Database password (Project Settings ? Database) ? local migrations only
# SUPABASE_DB_PASSWORD=

# Optional UK address lookup (getAddress.io). When unset, the CV builder
# falls back to OpenStreetMap Nominatim for house + postcode search.
# GETADDRESS_API_KEY=

# Optional GIPHY key for full GIF search in chat (free at developers.giphy.com).
# When unset, the chat GIF picker uses a small curated offline catalog.
# GIPHY_API_KEY=

# Access is deny-by-default via feature containers in src/lib/ai/access-container.ts
# ? AI only receives scopes/actions listed for that feature.
